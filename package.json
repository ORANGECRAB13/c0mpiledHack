{
  "name": "vocare-arrearage-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check:hardship": "node scripts/check-hardship.js",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "db:down": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_URL",
    "test:decision-layer": "node --test test/decision-layer/*.test.js",
    "seed:decision-layer": "node src/decision-layer/seed-cli.js",
    "sync:salesforce": "node src/decision-layer/sync-cli.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "neo4j-driver": "^6.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
