{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd compliance-drift && npm install",
  "buildCommand": "cd compliance-drift && npm run build",
  "outputDirectory": "compliance-drift/dist",
  "rewrites": [
    { "source": "/((?!api/|docs/|assets/).*)", "destination": "/index.html" }
  ]
}
